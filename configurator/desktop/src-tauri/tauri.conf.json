{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Provide",
  "version": "1.0.0",
  "identifier": "dev.tetonchallenge.provide",
  "build": {
    "devUrl": "http://localhost:8081",
    "frontendDist": "../../dist",
    "beforeDevCommand": { "script": "npx expo start --web --port 8081", "cwd": "../.." },
    "beforeBuildCommand": { "script": "npx expo export -p web", "cwd": "../.." }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Provide", "width": 1280, "height": 800, "minWidth": 400, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
