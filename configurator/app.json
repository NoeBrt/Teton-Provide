{
  "expo": {
    "name": "provide.",
    "slug": "sensor-provisioning-configurator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.sensorprovisioning.configurator",
      "infoPlist": {
        "CFBundleDisplayName": "Provide."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.sensorprovisioning.configurator",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-manager",
        {
          "bluetoothAlwaysPermission": "Bluetooth is used to find and set up nearby sensors."
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Face ID unlocks your technician code and the saved Wi-Fi passwords of your sites."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The camera reads your technician QR code and the site's Wi-Fi QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "644fba14-e2b7-4c74-9ad7-27f51d28e7f7"
      }
    },
    "owner": "noeeebt"
  }
}
